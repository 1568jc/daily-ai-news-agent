DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# true 使用明确标注的离线演示模型与动态样例；false 使用真实 DeepSeek API 和 RSS。
AINEWS_DEMO_MODE=true
AINEWS_NOW=
AINEWS_DB=data/ainews.db
AINEWS_TASK_DIR=data/tasks
AINEWS_MAX_ROUNDS=12
AINEWS_AGENT_TIMEOUT_SECONDS=240
AINEWS_NEWS_TIMEOUT_SECONDS=15
AINEWS_DAILY_HOUR=8
AINEWS_DAILY_MINUTE=0

# 留空即为本地邮件预览，不会发送邮件。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
